button{margin-top:18px;width:100%;padding:12px;border:0;border-radius:8px;background:#c8a24a;color:#111;font-weight:700;font-size:1rem;cursor:pointer}
.error{background:#3a1717;border:1px solid #7a2a2a;padding:12px;border-radius:8px;margin:16px 0}
.ok{background:#173a22;border:1px solid #2a7a44;padding:12px;border-radius:8px;margin:16px 0}
