LIQURSOFT_DB_HOST=127.0.0.1
LIQURSOFT_DB_USER=liquorsoft_app
LIQURSOFT_DB_PASSWORD=change_me
LIQURSOFT_DB_NAME=liquorsoft

# Solo desarrollo local: habilita simulacion, no procesa pagos reales.
LIQUORSOFT_APP_ENV=development
LIQUORSOFT_PAYMENT_SIMULATOR=1
LIQUORSOFT_COOKIE_SECURE=0
LIQUORSOFT_SESSION_SAVE_PATH=/tmp/liquorsoft-sessions

# PayPal Sandbox no esta habilitado hasta implementar y configurar su pasarela.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=sandbox
