# Configuración de entorno LiquorSoft
LIQUORSOFT_APP_ENV=development

# Base de datos MySQL
LIQURSOFT_DB_HOST=127.0.0.1
LIQURSOFT_DB_USER=root
LIQURSOFT_DB_PASSWORD=
LIQURSOFT_DB_NAME=liquorsoft

# Seguridad y cookies
LIQUORSOFT_COOKIE_SECURE=0
# LIQUORSOFT_SESSION_SAVE_PATH=

# Pasarela de pagos de prueba (Simulador Nequi / PSE)
LIQUORSOFT_PAYMENT_SIMULATOR=1

# Pasarela PayPal Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_COP_PER_USD=4000

