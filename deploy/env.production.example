# LiquorSoft - plantilla de entorno para hosting compartido.
# Copiar como .env en la raíz de htdocs/public_html (junto a la carpeta api/).
# NUNCA subir este archivo con credenciales al repositorio.

# development mantiene habilitado el simulador de pago de prueba.
# Cambiar a production solo si vas a configurar PayPal Sandbox.
LIQUORSOFT_APP_ENV=development

# Base de datos entregada por el hosting.
# Ojo: el nombre de estas cuatro variables lleva LIQURSOFT (sin la O),
# es el nombre que lee el código. No lo cambies.
LIQURSOFT_DB_HOST=sqlXXX.infinityfree.com
LIQURSOFT_DB_USER=if0_XXXXXXXX
LIQURSOFT_DB_PASSWORD=CAMBIAR_ESTA_CLAVE
LIQURSOFT_DB_NAME=if0_XXXXXXXX_liquorsoft

# Cookies: 1 cuando el sitio se sirve por HTTPS (obligatorio en producción).
LIQUORSOFT_COOKIE_SECURE=1
# Opcional: carpeta escribible para sesiones si el hosting no permite la del sistema.
# LIQUORSOFT_SESSION_SAVE_PATH=/home/volX/.../htdocs/tmp/sessions

# Simulador Nequi/PSE de prueba. Solo se activa con APP_ENV=development.
LIQUORSOFT_PAYMENT_SIMULATOR=1

# PayPal (opcional). Dejar vacío si no se usa.
# sandbox = dinero de prueba; live = cobros reales (usa credenciales Live).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_COP_PER_USD=4000
# ID del webhook creado en PayPal Developer > Webhooks.
# URL: https://TU-DOMINIO/api/paypal/webhook.php
PAYPAL_WEBHOOK_ID=

# Asistente con IA (opcional). Si está vacío o falla, usa respuestas locales.
LIQUORSOFT_OPENAI_API_KEY=
LIQUORSOFT_OPENAI_MODEL=gpt-4.1-mini

# Contacto público. Número en formato internacional sin signos (ej. 573001234567).
# Si se deja vacío, el botón flotante de WhatsApp no se muestra.
LIQUORSOFT_WHATSAPP_NUMBER=
LIQUORSOFT_WHATSAPP_MESSAGE=Hola LiquorSoft, quiero información sobre sus productos.
LIQUORSOFT_BUSINESS_NAME=LiquorSoft
LIQUORSOFT_SUPPORT_EMAIL=
